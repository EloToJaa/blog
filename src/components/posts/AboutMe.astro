---
import SocialIcons from "@components/common/SocialIcons.astro";
import { getEntry, render } from "astro:content";
const author = await getEntry("authors", "elotoja");
const { Content } = await render(author);
---

<section id="about-me" class="article-shell">
  <div class="page-heading">
    <p class="eyebrow">Behind the notebook</p>
    <h1>{author.data.name}</h1>
    <p>Software engineer. CTF player. Always learning.</p>
  </div>
  <div class="prose">
    <Content />
  </div>
  <div class="mt-10 border-t border-border pt-6">
    <h2 class="mb-4">Find me elsewhere</h2>
    <div class="flex">
      <SocialIcons author={author.data} />
    </div>
  </div>
</section>
