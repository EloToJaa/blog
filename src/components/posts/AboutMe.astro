---
import SocialIcons from "@components/common/SocialIcons.astro";
import { getEntry, render } from "astro:content";

const author = await getEntry("authors", "elotoja");
if (!author) throw new Error("Missing site author: elotoja");
const { Content } = await render(author);
---

<section id="about-me" class="mb-8">
  <h1 class="text-center">{author.data.name}</h1>
  <div class="mx-auto md:w-3/4 text-center">
    <Content />
  </div>
  <div class="mt-3">
    <SocialIcons author={author.data} />
  </div>
</section>
