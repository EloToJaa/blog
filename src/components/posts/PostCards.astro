---
import type { CollectionEntry } from "astro:content";
import Card from "./Card.svelte";
export type Props = {
  posts: CollectionEntry<"blog">[];
  sectionName: string;
  title?: string;
};
const { posts, sectionName, title = "Latest Posts" } = Astro.props;
---

<section id={sectionName} aria-label={title}>
  <div class="section-heading">
    <h2>{title}</h2>
    <slot />
  </div>
  <div class="post-grid">
    {posts.map(post => (
      <Card href={`/blog/${post.id}`} frontmatter={post.data} />
    ))}
  </div>
</section>
<style>
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
</style>
