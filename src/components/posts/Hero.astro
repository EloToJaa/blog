---
import { Button } from "@components/ui/button";
import SocialIcons from "@components/common/SocialIcons.astro";
import { getEntry } from "astro:content";
import ArrowDown from "~icons/ic/baseline-keyboard-arrow-down";

const author = await getEntry("authors", "elotoja");
---

<section class="min-h-[60vh] flex flex-col justify-center items-center text-center px-4 py-12 animate-fade-in-up">
  <div class="max-w-3xl">
    <h1 class="text-5xl md:text-7xl font-bold mb-4 bg-linear-to-r from-foreground to-muted-foreground bg-clip-text text-transparent">
      {author?.data.name}
    </h1>
    <div class="text-xl md:text-2xl text-muted-foreground mb-6 leading-relaxed">
      <p>
        Welcome to my personal blog where I share my thoughts on technology,
        programming, and cybersecurity.
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-4 mb-6">
      <Button href="/posts" size="lg">
        Read Blog
      </Button>
      <Button href="/about" variant="outline" size="lg">
        About Me
      </Button>
    </div>
    {author && (
      <div class="mt-4">
        <SocialIcons author={author?.data} />
      </div>
    )}
  </div>
  <div class="mt-8 animate-bounce">
    <a
      href="#posts"
      class="text-muted-foreground hover:text-primary transition-colors"
      aria-label="Scroll to posts"
    >
      <ArrowDown class="w-8 h-8" />
    </a>
  </div>
</section>
