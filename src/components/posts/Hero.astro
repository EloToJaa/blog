---
import { Button } from "@components/ui/button";
import { getEntry } from "astro:content";
import { loadPosts } from "@utils/blog";
import { tagUrl } from "@utils/posts";
const author = await getEntry("authors", "elotoja");
const topics = [
  ...new Set((await loadPosts()).flatMap(post => post.data.tags)),
];
---

<section class="intro" aria-labelledby="intro-title">
  <div>
    <p class="eyebrow">Software engineering & cybersecurity</p>
    <h1 id="intro-title">
      {author?.data.name}
      <span class="intro-handle">@EloToJa</span>
    </h1>
    <p class="intro-copy">
      Notes on building software,
      <br class="hidden md:block" /> taking things apart, and learning along the
      way.
    </p>
    <div class="intro-actions">
      <Button href="/posts" size="lg" class="min-h-11 px-4">
        Read Blog <span aria-hidden="true">↗</span>
      </Button>
      <a href="/about" class="text-link">
        About me
      </a>
    </div>
  </div>
  <aside class="topic-index" aria-label="Explore topics">
    <p class="eyebrow">Explore the notebook</p>
    <p class="topic-caption">Follow a thread.</p>
    <div class="tags">
      {topics.map(tag => (
        <a class="tag" href={tagUrl(tag)}>
          {tag}
          <span aria-hidden="true"> ↗</span>
        </a>
      ))}
    </div>
    <a href="/search" class="text-link topic-search">
      Search all writing <span aria-hidden="true">→</span>
    </a>
  </aside>
</section>
<style>
  .intro {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-block: 2rem 4.5rem;
  }
  h1 {
    margin-top: 1rem;
    font-family: "Fira Code Variable", monospace;
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    letter-spacing: -0.075em;
  }
  .intro-handle {
    display: block;
    margin-top: 0.8rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    letter-spacing: -0.03em;
    font-weight: 400;
  }
  .intro-copy {
    max-width: 35rem;
    margin-block: 1.75rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--muted-foreground);
    line-height: 1.65;
  }
  .intro-actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .topic-index {
    border-left: 3px solid var(--primary);
    padding: 1.75rem;
    background: var(--muted);
    border-radius: 0 0.75rem 0.75rem 0;
  }
  .topic-caption {
    margin-block: 0.5rem 1.5rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .topic-index .tag {
    background: var(--card);
  }
  .topic-search {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.875rem;
  }
  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 1rem 3rem;
    }
  }
</style>
