---
import { pageUrl } from "@utils/posts";
import { Button } from "@components/ui/button";
export type Props = { lastPage: number; currentPage: number };
const { lastPage, currentPage } = Astro.props;
const pages = Array.from({ length: lastPage }, (_, index) => index + 1);
const href = pageUrl;
---

{lastPage > 1 && (
  <nav aria-label="Pagination" class="flex flex-wrap gap-2 mt-8">
    {currentPage > 1 && (
      <Button variant="outline" href={href(currentPage - 1)}>
        Previous
      </Button>
    )}
    {pages.map(page => (
      <Button
        variant={page === currentPage ? "default" : "ghost"}
        href={href(page)}
        aria-current={page === currentPage ? "page" : undefined}
        aria-label={`Page ${page}`}
      >
        {page}
      </Button>
    ))}
    {currentPage < lastPage && (
      <Button variant="outline" href={href(currentPage + 1)}>
        Next
      </Button>
    )}
  </nav>
)}
