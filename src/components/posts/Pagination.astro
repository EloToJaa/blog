---
import { Button } from "@components/ui/button";
export type Props = { lastPage: number; currentPage: number };
const { lastPage, currentPage } = Astro.props;
const pages = Array.from({ length: lastPage }, (_, index) => index + 1);
---

<nav aria-label="Pagination" class="flex flex-wrap gap-2">
  <Button
    href={currentPage > 1 ? `/posts/${currentPage - 1}` : undefined}
    disabled={currentPage <= 1}
    variant="outline"
  >
    Previous
  </Button>
  {pages.map(page => (
    <Button
      href={`/posts/${page}`}
      variant={page === currentPage ? "default" : "outline"}
      aria-current={page === currentPage ? "page" : undefined}
    >
      {page}
    </Button>
  ))}
  <Button
    href={currentPage < lastPage ? `/posts/${currentPage + 1}` : undefined}
    disabled={currentPage >= lastPage}
    variant="outline"
  >
    Next
  </Button>
</nav>
