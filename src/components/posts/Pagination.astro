---
import { pageUrl } from "@utils/posts";
export type Props = { lastPage: number; currentPage: number };
const { lastPage, currentPage } = Astro.props;
const pages = Array.from({ length: lastPage }, (_, i) => i + 1);
---

<nav class="join join-horizontal" aria-label="Post pages">
  {currentPage > 1 ? (
    <a class="btn btn-primary join-item" href={pageUrl(currentPage - 1)}>
      Previous
    </a>
  ) : (
    <button class="btn join-item" disabled>
      Previous
    </button>
  )}
  {pages.map(page => (
    <a
      class="btn btn-secondary join-item"
      href={pageUrl(page)}
      aria-current={page === currentPage ? "page" : undefined}
    >
      {page}
    </a>
  ))}
  {currentPage < lastPage ? (
    <a class="btn btn-primary join-item" href={pageUrl(currentPage + 1)}>
      Next
    </a>
  ) : (
    <button class="btn join-item" disabled>
      Next
    </button>
  )}
</nav>
