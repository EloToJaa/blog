---
import type { AuthorFrontmatter } from "@schema/author";
import DiscordIcon from "~icons/mdi/discord";
import GithubIcon from "~icons/mdi/github";
import LinkedinIcon from "~icons/mdi/linkedin";
import RedditIcon from "~icons/mdi/reddit";
import TwitterIcon from "~icons/mdi/twitter-circle";
import HackTheBoxIcon from "~icons/simple-icons/hackthebox";
import NewTabIcon from "./NewTabIcon.astro";

export type Props = {
  author: AuthorFrontmatter;
  small?: boolean;
};

const { author, small = false } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {author.github && (
    <NewTabIcon href={author.github} description="GitHub (opens in a new tab)">
      <GithubIcon />
    </NewTabIcon>
  )}
  {author.twitter && (
    <NewTabIcon
      href={author.twitter}
      description="Twitter (opens in a new tab)"
    >
      <TwitterIcon />
    </NewTabIcon>
  )}
  {author.reddit && !small && (
    <NewTabIcon href={author.reddit} description="Reddit (opens in a new tab)">
      <RedditIcon />
    </NewTabIcon>
  )}
  {author.discord && !small && (
    <NewTabIcon
      href={author.discord}
      description="Discord (opens in a new tab)"
    >
      <DiscordIcon />
    </NewTabIcon>
  )}
  {author.linkedin && !small && (
    <NewTabIcon
      href={author.linkedin}
      description="LinkedIn (opens in a new tab)"
    >
      <LinkedinIcon />
    </NewTabIcon>
  )}
  {author.hackthebox && !small && (
    <NewTabIcon
      href={author.hackthebox}
      description="Hack The Box (opens in a new tab)"
    >
      <HackTheBoxIcon />
    </NewTabIcon>
  )}
</div>
