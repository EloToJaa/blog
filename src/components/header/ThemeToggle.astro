---
import { Button } from "@components/ui/button";
import LightMode from "~icons/ic/round-light-mode";
import DarkMode from "~icons/ic/round-dark-mode";
---

<Button
  variant="ghost"
  size="icon"
  id="theme-button"
  aria-label="Toggle theme"
  class="icon-link"
>
  <LightMode class="size-5 light-icon" />
  <DarkMode class="size-5 dark-icon" />
</Button>
<style>
  .light-icon {
    display: none;
  }
  :global([data-theme="dark"]) .light-icon {
    display: block;
  }
  :global([data-theme="dark"]) .dark-icon {
    display: none;
  }
</style>
<script>
  import { applyTheme } from "@utils/theme";
  document.addEventListener("astro:page-load", () => {
    document.getElementById("theme-button")?.addEventListener("click", () => {
      const theme =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      applyTheme(document.documentElement, theme);
      try {
        localStorage.setItem("theme", theme);
      } catch {
        /* Theme remains usable without storage. */
      }
    });
  });
</script>
