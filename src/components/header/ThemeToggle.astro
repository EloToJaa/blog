---
import { Button } from "@components/ui/button";
import LightMode from "~icons/ic/round-light-mode";
import DarkMode from "~icons/ic/round-dark-mode";
---

<Button
  variant="ghost"
  size="icon-sm"
  id="theme-button"
  aria-live="polite"
  aria-label="Toggle theme"
  class="p-0"
>
  <div class="relative w-7 h-7 mx-auto">
    <LightMode id="light-icon" class="w-full h-full absolute inset-0" />
    <DarkMode id="dark-icon" class="w-full h-full absolute inset-0" />
  </div>
</Button>

<script>
  import { applyTheme, getTheme } from "@utils/theme";
  function readStoredTheme() {
    try {
      return localStorage.getItem("theme");
    } catch {
      return null;
    }
  }
  function setupTheme() {
    const button = document.getElementById("theme-button");
    const update = () => {
      const theme = getTheme(
        readStoredTheme(),
        window.matchMedia("(prefers-color-scheme: dark)").matches
      );
      applyTheme(document.documentElement, theme);
      document
        .getElementById("light-icon")
        ?.classList.toggle("hidden", theme !== "dark");
      document
        .getElementById("dark-icon")
        ?.classList.toggle("hidden", theme === "dark");
    };
    update();
    button?.addEventListener("click", () => {
      const theme = document.documentElement.classList.contains("dark")
        ? "light"
        : "dark";
      try {
        localStorage.setItem("theme", theme);
      } catch {
        /* Storage is optional. */
      }
      applyTheme(document.documentElement, theme);
      document
        .getElementById("light-icon")
        ?.classList.toggle("hidden", theme !== "dark");
      document
        .getElementById("dark-icon")
        ?.classList.toggle("hidden", theme === "dark");
    });
  }
  document.addEventListener("astro:page-load", setupTheme);
</script>
