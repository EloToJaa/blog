---
import { Button } from "@components/ui/button";
import Hamburger from "~icons/ic/baseline-menu";
---

<Button
  variant="ghost"
  size="icon"
  id="hamburger-button"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="navbar"
  class="icon-link menu-toggle"
>
  <Hamburger class="size-6" />
</Button>
<style>
  :global(.menu-toggle) {
    display: none;
  }
  @media (max-width: 640px) {
    :global(.menu-toggle) {
      display: inline-flex;
    }
  }
</style>
