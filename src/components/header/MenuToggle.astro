---
import HamburgerOpen from "~icons/ic/baseline-menu";
import HamburgerClose from "~icons/ic/round-close";
---

<button
  id="hamburger-button"
  aria-label="open menu"
  aria-expanded="false"
  aria-controls="navbar"
  class="swap swap-rotate swap-active size-8"
>
  <div class="swap-on size-7">
    <HamburgerOpen />
  </div>
  <div class="swap-off size-7">
    <HamburgerClose />
  </div>
</button>
