---
import { Button } from "@components/ui/button";
import HamburgerOpen from "~icons/ic/baseline-menu";
import HamburgerClose from "~icons/ic/round-close";
---

<Button
  variant="ghost"
  size="icon-sm"
  id="hamburger-button"
  aria-label="open menu"
  aria-expanded="false"
  aria-controls="navbar"
  class="group"
>
  <div class="size-7 group-aria-expanded:hidden">
    <HamburgerOpen />
  </div>
  <div class="hidden size-7 group-aria-expanded:block">
    <HamburgerClose />
  </div>
</Button>
