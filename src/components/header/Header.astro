---
import { Button } from "@components/ui/button";
import MenuToggle from "./MenuToggle.astro";
import HeaderLinks from "./HeaderLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SearchLogo from "~icons/ic/baseline-search";
---

<header class="site-header">
  <div class="site-shell header-inner">
    <a href="/" class="wordmark" aria-label="EloToJa home">
      <span aria-hidden="true">[</span> EloToJa{" "}
      <span aria-hidden="true">]</span>
    </a>
    <div class="header-tools">
      <Button
        variant="ghost"
        size="icon"
        href="/search"
        class="icon-link"
        aria-label="Search posts"
      >
        <SearchLogo class="size-6" />
      </Button>
      <ThemeToggle />
      <MenuToggle />
    </div>
    <nav id="navbar" aria-label="Main navigation">
      <HeaderLinks ulClass="nav-links" />
    </nav>
  </div>
</header>
<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }
  .header-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .wordmark {
    font:
      600 1.15rem "Fira Code Variable",
      monospace;
    letter-spacing: -0.05em;
    margin-right: auto;
  }
  .wordmark span {
    color: var(--primary);
  }
  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    order: 2;
  }
  nav {
    order: 1;
  }
  :global(.nav-links) {
    display: flex;
    gap: 1.5rem;
  }
  :global(.nav-links a) {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--muted-foreground);
  }
  :global(.nav-links a[aria-current="page"]),
  :global(.nav-links a:hover) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.5em;
  }
  @media (max-width: 640px) {
    .header-inner {
      min-height: 76px;
      gap: 0;
    }
    .header-tools {
      order: 1;
    }
    nav {
      display: none;
      width: 100%;
      order: 2;
      padding-bottom: 1rem;
    }
    nav[data-open] {
      display: block;
    }
  }
</style>
<script>
  document.addEventListener("astro:page-load", () => {
    const navbar = document.getElementById("navbar");
    const button = document.getElementById("hamburger-button");
    const setOpen = (open: boolean) => {
      navbar?.toggleAttribute("data-open", open);
      button?.setAttribute("aria-expanded", String(open));
      button?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    button?.addEventListener("click", () =>
      setOpen(button.getAttribute("aria-expanded") !== "true")
    );
    navbar?.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;
      setOpen(false);
      button?.focus();
    });
    button?.addEventListener("keydown", event => {
      if (event.key === "Escape") setOpen(false);
    });
  });
</script>
