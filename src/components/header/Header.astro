---
import MenuToggle from "./MenuToggle.astro";
import HeaderLinks from "./HeaderLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SearchLogo from "~icons/ic/baseline-search";
import RssIcon from "@components/common/RssIcon.astro";
---

<header
  class="sticky top-0 z-50 py-2 bg-base-200/95 backdrop-blur-md shadow-sm border-b border-base-300 transition-all duration-300"
>
  <div class="container mx-auto flex justify-between flex-wrap items-center">
    <div class="my-auto flex items-center w-1/4">
      <a
        href="/"
        class="btn btn-ghost normal-case text-2xl md:text-3xl font-bold hover:bg-base-300 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-lg"
      >
        EloToJa
      </a>
      <div class="my-auto hidden md:block ml-2">
        <RssIcon />
      </div>
    </div>
    <div class="md:hidden my-auto mr-3 flex">
      <MenuToggle />
    </div>
    <navbar
      id="navbar"
      class="hidden md:flex w-full md:w-3/4 justify-end items-center"
    >
      <nav class="mx-auto w-min md:mx-0 md:w-max">
        <HeaderLinks
          ulClass="menu menu-vertical md:menu-horizontal p-2 rounded-box text-lg gap-1"
          liClass="hover:bg-base-300 rounded-md mx-auto w-min transition-colors duration-200"
          activeClass="font-bold underline underline-offset-4 decoration-2 bg-base-300"
        />
      </nav>
      <div class="flex w-min mx-auto md:mx-0 md:w-max gap-x-3 items-center">
        <a
          href="/search"
          title="Search posts"
          class="btn btn-ghost btn-circle hover:bg-base-300 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 size-8"
          aria-label="Search posts"
        >
          <SearchLogo class="size-7" />
        </a>
        <ThemeToggle />
      </div>
    </navbar>
  </div>
</header>

<script>
  let open = false;
  const navbar = document.getElementById("navbar");
  const menuButton = document.getElementById("hamburger-button");

  menuButton?.addEventListener("click", () => {
    open = !open;
    menuButton?.setAttribute("aria-expanded", open.toString());
    menuButton?.setAttribute("aria-label", open ? "close menu" : "open menu");
    menuButton?.classList.toggle("swap-active");
    navbar?.classList.toggle("hidden");
    navbar?.classList.toggle("flex");
  });
</script>
