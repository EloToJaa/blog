---
import { NAVBAR } from "@config";
export type Props = { ulClass?: string };
const { ulClass } = Astro.props;
const isActive = (url: string) =>
  Astro.url.pathname === url ||
  Astro.url.pathname.startsWith(`${url}/`) ||
  (url === "/posts" && Astro.url.pathname.startsWith("/blog/"));
---

<ul class={ulClass}>
  {NAVBAR.map(item => (
    <li>
      <a href={item.url} aria-current={isActive(item.url) ? "page" : undefined}>
        {item.title}
      </a>
    </li>
  ))}
</ul>
