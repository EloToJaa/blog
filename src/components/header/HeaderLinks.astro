---
import { NAVBAR } from "@config";
import cn from "@utils/cn.js";

export type Props = {
  ulClass?: string;
  liClass?: string;
  activeClass?: string;
};

const { ulClass = "", liClass = "", activeClass = "" } = Astro.props;
---

<ul class={ulClass}>
  {NAVBAR.map(item => (
    <li
      class={cn(
        liClass,
        (Astro.url.pathname === item.url ||
          Astro.url.pathname.startsWith(item.url + "/")) &&
          activeClass
      )}
    >
      <a
        href={item.url}
        aria-current={
          Astro.url.pathname === item.url ||
          Astro.url.pathname.startsWith(item.url + "/")
            ? "page"
            : undefined
        }
      >
        {item.title}
      </a>
    </li>
  ))}
</ul>
