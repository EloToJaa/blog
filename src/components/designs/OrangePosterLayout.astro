---
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/fira-code";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Łukasz Budziak's notes on software engineering, programming, and cybersecurity."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — EloToJa</title>
  </head>
  <body class="poster">
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="masthead">
      <a class="wordmark" href="/designs/orange-poster/">
        EloToJa<span>®</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/designs/orange-poster/#writing">Writing</a>
        <a href="/designs/orange-poster/#about">About</a>
        <a class="github" href="https://github.com/elotojaa">
          GitHub ↗
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <span>Łukasz Budziak / EloToJa</span>
      <a href="/rss.xml">Follow via RSS ↗</a>
      <span>Software. Security. Curiosity.</span>
    </footer>
  </body>
</html>
<style is:global>
  .poster {
    --orange: #ff681f;
    --navy: #14213d;
    --paper: #f7f8fa;
    --muted: #64718a;
    margin: 0;
    color: var(--navy);
    background: var(--paper);
    font-family: "Source Sans 3 Variable", sans-serif;
  }
  .poster *,
  .poster *::before,
  .poster *::after {
    box-sizing: border-box;
  }
  .poster a {
    color: inherit;
    text-decoration: none;
  }
  .poster a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .poster a:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 6px;
  }
  .poster .skip {
    position: fixed;
    top: -100px;
    left: 16px;
    z-index: 10;
    background: white;
    padding: 12px;
  }
  .poster .skip:focus {
    top: 16px;
  }
  .poster .masthead {
    min-height: 100px;
    padding: 20px 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--navy);
    color: white;
  }
  .poster .wordmark {
    font-size: 35px;
    font-weight: 900;
    letter-spacing: -1.5px;
  }
  .poster .wordmark span {
    font-size: 12px;
    vertical-align: top;
    display: inline-block;
    margin: 9px 0 0 4px;
  }
  .poster nav {
    display: flex;
    gap: 38px;
    align-items: center;
    font-size: 16px;
    font-weight: 600;
  }
  .poster nav .github {
    border: 1px solid #64718a;
    padding: 10px 20px;
  }
  .poster .eyebrow {
    font:
      12px/1.6 "Fira Code Variable",
      monospace;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
  .poster .hero {
    background: var(--orange);
    padding: 42px 5.5% 42px;
  }
  .poster .hero-meta {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #14213d55;
    padding-bottom: 19px;
  }
  .poster .hero-grid {
    display: grid;
    grid-template-columns: 1fr 290px;
    gap: 40px;
    align-items: center;
    padding: 35px 0 26px;
  }
  .poster .display {
    margin: 0;
    font-weight: 900;
    font-size: clamp(100px, 12.5vw, 190px);
    letter-spacing: -0.065em;
    line-height: 0.82;
  }
  .poster .display span {
    display: block;
    transform: scaleX(0.84);
    transform-origin: left;
    width: 119%;
  }
  .poster .code-mark {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .poster .brace {
    font-size: 180px;
    font-weight: 300;
    line-height: 1;
  }
  .poster .code-words {
    font:
      15px/2.1 "Fira Code Variable",
      monospace;
  }
  .poster .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-top: 26px;
  }
  .poster .hero-bottom p {
    max-width: 480px;
    font-size: 20px;
    line-height: 1.45;
    margin: 0;
  }
  .poster .read-link {
    display: flex;
    gap: 28px;
    padding: 17px 22px;
    background: var(--navy);
    color: white;
    font-weight: 600;
    white-space: nowrap;
  }
  .poster .writing {
    padding: 65px 5.5% 80px;
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 50px;
  }
  .poster .section-label {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .poster .feature-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: var(--muted);
    font:
      12px/1.6 "Fira Code Variable",
      monospace;
  }
  .poster .feature h2 {
    font-size: clamp(32px, 3.8vw, 55px);
    line-height: 1.05;
    letter-spacing: -1.5px;
    margin: 21px 0 15px;
    max-width: 720px;
  }
  .poster .feature p {
    max-width: 680px;
    font-size: 19px;
    line-height: 1.55;
    margin: 0 0 28px;
    color: #48546c;
  }
  .poster .text-link {
    font-weight: 700;
    display: inline-block;
    border-bottom: 2px solid var(--orange);
    padding-bottom: 5px;
  }
  .poster .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }
  .poster .tags li {
    font:
      11px/1.5 "Fira Code Variable",
      monospace;
    padding: 5px 9px;
    background: #e9edf3;
  }
  .poster .about {
    background: var(--navy);
    color: white;
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 50px;
    padding: 65px 5.5%;
  }
  .poster .about h2 {
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin: 0 0 20px;
  }
  .poster .about p {
    max-width: 650px;
    color: #c7cedb;
    font-size: 20px;
    line-height: 1.6;
    margin: 0 0 25px;
  }
  .poster .about .text-link {
    color: var(--orange);
  }
  .poster .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 25px 5.5%;
    background: var(--navy);
    color: #c7cedb;
    border-top: 1px solid #64718a;
    font:
      11px/1.7 "Fira Code Variable",
      monospace;
  }
  .poster .article-hero {
    background: var(--orange);
    padding: 35px 5.5% 55px;
  }
  .poster .back-link {
    font-size: 14px;
    font-weight: 600;
  }
  .poster .article-hero .eyebrow {
    margin-top: 40px;
  }
  .poster .article-hero h1 {
    max-width: 1030px;
    font-size: clamp(45px, 6.5vw, 94px);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.045em;
    margin: 22px 0 30px;
  }
  .poster .article-hero .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
    font:
      12px/1.7 "Fira Code Variable",
      monospace;
  }
  .poster .article-grid {
    display: grid;
    grid-template-columns: 230px minmax(0, 760px);
    justify-content: center;
    align-items: start;
    gap: 75px;
    padding: 60px 5.5% 100px;
  }
  .poster .contents {
    position: sticky;
    top: 35px;
  }
  .poster .contents nav {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 15px;
    margin-top: 25px;
    font-size: 15px;
  }
  .poster .contents a {
    border-left: 2px solid var(--orange);
    padding-left: 13px;
  }
  .poster .prose {
    min-width: 0;
    font-size: 19px;
    line-height: 1.75;
  }
  .poster .prose > :first-child {
    margin-top: 0;
  }
  .poster .prose h2 {
    font-size: 34px;
    line-height: 1.2;
    letter-spacing: -1px;
    margin: 55px 0 20px;
    scroll-margin-top: 25px;
  }
  .poster .prose h3 {
    font-size: 26px;
    line-height: 1.3;
    margin-top: 35px;
  }
  .poster .prose h4 {
    font-size: 19px;
  }
  .poster .prose p {
    margin: 18px 0;
  }
  .poster .prose img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 30px 0;
  }
  .poster .prose a {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .poster .prose code:not(pre code) {
    font-family: "Fira Code Variable", monospace;
    font-size: 0.8em;
    background: #e9edf3;
    padding: 2px 4px;
    overflow-wrap: anywhere;
  }
  .poster .prose .expressive-code {
    margin: 25px 0;
    font-size: 14px;
  }
  .poster .prose pre {
    overflow: auto;
  }
  @media (max-width: 900px) {
    .poster .hero-grid {
      grid-template-columns: 1fr 190px;
      gap: 10px;
    }
    .poster .code-words {
      font-size: 12px;
    }
    .poster .brace {
      font-size: 130px;
    }
    .poster .hero-bottom {
      align-items: start;
      flex-direction: column;
    }
    .poster .writing,
    .poster .about {
      grid-template-columns: 150px 1fr;
      gap: 25px;
    }
    .poster .article-grid {
      grid-template-columns: 160px minmax(0, 1fr);
      gap: 30px;
    }
  }
  @media (max-width: 600px) {
    .poster .masthead {
      min-height: 82px;
      padding: 16px 6%;
    }
    .poster .wordmark {
      font-size: 28px;
    }
    .poster nav {
      gap: 20px;
      font-size: 14px;
    }
    .poster nav .github {
      display: none;
    }
    .poster .hero {
      padding: 26px 6% 35px;
    }
    .poster .hero-meta {
      font-size: 10px;
    }
    .poster .hero-meta span:last-child {
      display: none;
    }
    .poster .hero-grid {
      display: block;
      padding: 30px 0 5px;
    }
    .poster .display {
      font-size: clamp(85px, 22vw, 130px);
    }
    .poster .code-mark {
      margin-top: 30px;
    }
    .poster .brace {
      font-size: 65px;
    }
    .poster .code-words {
      font-size: 11px;
      line-height: 1.8;
    }
    .poster .hero-bottom {
      gap: 23px;
      margin-top: 20px;
    }
    .poster .hero-bottom p {
      font-size: 18px;
    }
    .poster .read-link {
      padding: 14px 17px;
      font-size: 15px;
    }
    .poster .writing,
    .poster .about {
      display: block;
      padding: 38px 6%;
    }
    .poster .section-label {
      margin-bottom: 25px;
    }
    .poster .feature-meta {
      font-size: 10px;
    }
    .poster .feature h2 {
      font-size: 35px;
    }
    .poster .feature p {
      font-size: 18px;
    }
    .poster .about h2 {
      font-size: 38px;
    }
    .poster .about p {
      font-size: 18px;
    }
    .poster .footer {
      padding: 22px 6%;
    }
    .poster .footer span:last-child {
      display: none;
    }
    .poster .article-hero {
      padding: 25px 6% 35px;
    }
    .poster .article-hero .eyebrow {
      margin-top: 30px;
    }
    .poster .article-hero h1 {
      font-size: 48px;
    }
    .poster .article-hero .byline {
      gap: 12px;
      font-size: 11px;
    }
    .poster .article-grid {
      display: block;
      padding: 35px 6% 55px;
    }
    .poster .contents {
      position: static;
      margin-bottom: 35px;
    }
    .poster .contents nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 13px;
      margin-top: 15px;
      font-size: 13px;
    }
    .poster .prose {
      font-size: 18px;
    }
    .poster .prose h2 {
      font-size: 30px;
    }
  }
</style>
