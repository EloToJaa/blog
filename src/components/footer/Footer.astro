---
import RssIcon from "@components/common/RssIcon.astro";
import SocialIcons from "@components/common/SocialIcons.astro";
import { getEntry } from "astro:content";

const author = await getEntry("authors", "elotoja");
---

<footer class="bg-base-200 border-t border-base-300 mt-auto">
  <div class="container mx-auto py-6 px-4">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-sm text-base-content/70 text-center md:text-left">
        <span>© 2024 {author?.data?.name || "EloToJa"}</span>
        <span class="mx-2">|</span>
        <span>All rights reserved</span>
      </div>
      <div class="flex items-center gap-3">
        <SocialIcons author={author?.data} small />
        <div class="border-l border-base-300 pl-3">
          <RssIcon />
        </div>
      </div>
    </div>
  </div>
</footer>
