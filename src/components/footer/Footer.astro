---
import RssIcon from "@components/common/RssIcon.astro";
import SocialIcons from "@components/common/SocialIcons.astro";
import { getEntry } from "astro:content";
const author = await getEntry("authors", "elotoja");
---

<footer class="border-t border-border">
  <div class="site-shell flex flex-wrap justify-between items-center gap-4 py-7">
    <div class="text-sm muted">
      <p>
        © {new Date().getFullYear()} {author?.data.name ?? "EloToJa"}
      </p>
      <p class="text-xs mt-1">Notes on software & cybersecurity.</p>
    </div>
    <div class="flex items-center gap-2">
      {author && <SocialIcons author={author.data} small />}
      <RssIcon />
    </div>
  </div>
</footer>
