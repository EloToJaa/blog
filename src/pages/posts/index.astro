---
import Pagination from "@components/posts/Pagination.astro";
import PostCards from "@components/posts/PostCards.astro";
import { POSTS_PER_PAGE } from "@config";
import MainLayout from "@layouts/MainLayout.astro";
import { loadPosts } from "@utils/blog";
import { getPage, lastPage } from "@utils/posts";

const allPosts = await loadPosts();

const currentPage = 1;
const pageCount = lastPage(allPosts.length, POSTS_PER_PAGE);

const posts = getPage(allPosts, currentPage, POSTS_PER_PAGE);
---

<MainLayout title="Posts">
  <PostCards posts={posts} sectionName="posts" />
  <Pagination lastPage={pageCount} currentPage={currentPage} />
</MainLayout>
