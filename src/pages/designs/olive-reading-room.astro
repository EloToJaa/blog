---
import OliveReadingRoom from "../../layouts/designs/OliveReadingRoom.astro";
import { getEntry } from "astro:content";
const post = await getEntry("blog", "cyber-apocalypse");
if (!post) throw new Error("Cyber Apocalypse article is missing");
---

<OliveReadingRoom title="The reading room">
  <main id="main">
    <section class="opening" id="top" aria-labelledby="opening-title">
      <div class="opening-copy">
        <p class="eyebrow">A personal collection of technical notes</p>
        <h1 id="opening-title">
          Notes worth
          <br />
          <em>keeping.</em>
        </h1>
        <p class="intro serif">
          On building things, taking them apart,
          <br class="desktop-break" /> and understanding what makes them work.
        </p>
        <p class="byline">
          Written by Łukasz Budziak.
          <br />
          Software engineer. CTF player. Teacher.
        </p>
        <a class="text-link" href="#writing">
          Find something to read <span aria-hidden="true">↓</span>
        </a>
      </div>
      <a
        class="bookmark"
        href="/designs/olive-reading-room/article"
        aria-label="Read Cyber Apocalypse 2024: Hacker Royale"
      >
        <span class="bookmark-small">EloToJa's reading room</span>
        <span class="bookmark-title">
          Software.
          <br />
          Security.
          <br />
          <em>Curiosity.</em>
        </span>
        <span class="bookmark-bottom">
          Keep exploring
          <br />
          <span aria-hidden="true">↓</span>
        </span>
      </a>
    </section>
    <section class="writing" id="writing" aria-labelledby="writing-title">
      <div class="section-label">
        <h2 id="writing-title" class="eyebrow">
          Latest writing
        </h2>
        <p>From the notebook</p>
      </div>
      <article class="featured">
        <div class="meta">
          <time datetime="2024-03-20">20 March 2024</time>
          <span>CTF writeup</span>
        </div>
        <h3>
          <a href="/designs/olive-reading-room/article">
            Cyber Apocalypse 2024:
            <br />
            <em>Hacker Royale</em>
          </a>
        </h3>
        <p class="serif">{post.data.description}</p>
        <div class="feature-bottom">
          <a class="text-link" href="/designs/olive-reading-room/article">
            Read the writeup <span aria-hidden="true">↗</span>
          </a>
          <span class="topics">Web · PWN · Crypto · Reversing · Misc</span>
        </div>
      </article>
    </section>
    <section id="about" class="about" aria-labelledby="about-title">
      <p class="eyebrow">Behind the notes</p>
      <div>
        <h2 id="about-title">Hello, I'm Łukasz.</h2>
        <p class="serif">
          I am a software engineer who likes to explore different technologies
          and try out different tools. I take part in CTF competitions with
          StormChasers and enjoy competitive programming.
        </p>
        <p class="serif">
          I also love teaching other people programming and cybersecurity. This
          is where I share what I learn.
        </p>
        <div class="socials">
          <a href="https://github.com/elotojaa">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/elotoja/">LinkedIn ↗</a>
          <a href="https://app.hackthebox.com/users/690879">Hack The Box ↗</a>
        </div>
      </div>
    </section>
  </main>
</OliveReadingRoom>
<style>
  .opening {
    position: relative;
    max-width: 1232px;
    margin: 25px auto 80px;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 80px;
    padding: 30px 0 25px;
  }
  .opening-copy > .eyebrow {
    margin: 0 0 38px;
  }
  h1 {
    font-family: "Literata", Georgia, serif;
    font-size: clamp(70px, 7.2vw, 104px);
    font-weight: 400;
    letter-spacing: -5px;
    line-height: 1.04;
    margin: 0 0 32px;
  }
  h1 em {
    font-weight: 400;
  }
  .intro {
    font-size: 25px;
    line-height: 1.55;
    margin: 0 0 28px;
  }
  .byline {
    font-size: 15px;
    line-height: 1.6;
    color: var(--moss);
    margin-bottom: 26px;
  }
  .bookmark {
    background: var(--olive);
    color: var(--paper);
    padding: 48px 38px 110px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 520px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 88%, 0 100%);
    text-decoration: none;
    margin-top: -86px;
    position: relative;
  }
  .bookmark:focus-visible {
    clip-path: none;
    outline: 4px solid var(--ink);
    outline-offset: 5px;
  }
  .bookmark:hover .bookmark-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 9px;
  }
  .bookmark-small {
    font-size: 11px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    border-top: 1px solid #8c9272;
    padding-top: 22px;
  }
  .bookmark-title {
    font-family: "Literata", Georgia, serif;
    font-size: 39px;
    line-height: 1.35;
    letter-spacing: -1px;
  }
  .bookmark-bottom {
    font-size: 13px;
    line-height: 2;
  }
  .bookmark-bottom span {
    font-size: 28px;
  }
  .writing {
    max-width: 1232px;
    margin: 0 auto;
    border-top: 1px solid #a9af8b;
    border-bottom: 1px solid #a9af8b;
    padding: 48px 0 52px;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
  }
  .section-label h2 {
    margin: 0 0 10px;
  }
  .section-label p {
    font-size: 14px;
    color: var(--moss);
    margin: 0;
  }
  .meta {
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: flex;
    gap: 28px;
    color: var(--moss);
  }
  h3 {
    font-family: "Literata", Georgia, serif;
    font-size: 43px;
    line-height: 1.16;
    font-weight: 400;
    margin: 23px 0 24px;
    letter-spacing: -1.3px;
  }
  h3 a {
    text-decoration: none;
  }
  .featured > p {
    font-size: 19px;
    line-height: 1.65;
    max-width: 670px;
  }
  .feature-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    margin-top: 28px;
  }
  .topics {
    font-size: 12px;
    color: var(--moss);
  }
  .about {
    max-width: 1232px;
    margin: 0 auto;
    padding: 65px 0 80px;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
  }
  .about > .eyebrow {
    margin-top: 10px;
  }
  .about h2 {
    font-family: "Literata", Georgia, serif;
    font-size: 36px;
    font-weight: 400;
    margin: 0 0 22px;
  }
  .about .serif {
    font-size: 18px;
    line-height: 1.7;
    max-width: 700px;
  }
  .socials {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 28px;
    font-size: 14px;
  }
  @media (max-width: 1359px) {
    .opening,
    .writing,
    .about {
      margin-inline: 64px;
    }
    .opening {
      grid-template-columns: 1fr 280px;
      gap: 40px;
    }
    .bookmark {
      padding-inline: 30px;
    }
  }
  @media (max-width: 900px) {
    .opening {
      grid-template-columns: 1fr 220px;
    }
    .bookmark-title {
      font-size: 29px;
    }
    h1 {
      font-size: 74px;
      letter-spacing: -3px;
    }
    .writing,
    .about {
      grid-template-columns: 160px 1fr;
      gap: 35px;
    }
    .feature-bottom {
      display: block;
    }
    .topics {
      display: block;
      margin-top: 18px;
    }
  }
  @media (max-width: 640px) {
    .opening,
    .writing,
    .about {
      margin-inline: 24px;
    }
    .opening {
      margin-top: 28px;
      margin-bottom: 50px;
      display: block;
      padding-top: 0;
    }
    .opening-copy > .eyebrow {
      font-size: 10px;
      letter-spacing: 1.4px;
      max-width: 230px;
      margin-bottom: 28px;
    }
    h1 {
      font-size: 66px;
    }
    .intro {
      font-size: 21px;
    }
    .desktop-break {
      display: none;
    }
    .bookmark {
      min-height: 250px;
      margin-top: 38px;
      padding: 25px 28px 55px;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 25px;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 87%, 0 100%);
    }
    .bookmark-small {
      width: 100%;
      padding-top: 12px;
    }
    .bookmark-title {
      font-size: 29px;
    }
    .bookmark-bottom {
      align-self: center;
    }
    .writing,
    .about {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-block: 35px;
    }
    h3 {
      font-size: 34px;
    }
    .meta {
      gap: 20px;
      font-size: 11px;
    }
    .featured > p {
      font-size: 18px;
    }
    .about {
      padding-bottom: 50px;
    }
  }
</style>
