---
import LabNotebookLayout from "../../../layouts/designs/LabNotebookLayout.astro";
import { loadPosts } from "../../../utils/blog";
import { render } from "astro:content";
import { tagUrl } from "../../../utils/posts";
const posts = await loadPosts();
const post = posts.find(entry => entry.id === "cyber-apocalypse") ?? posts[0];
if (!post) throw new Error("The notebook needs a published entry.");
const { Content, headings } = await render(post);
const sections = headings.filter(heading => heading.depth === 2);
const date = post.data.pubDatetime.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<LabNotebookLayout title={post.data.title} description={post.data.description}>
  <div class="article-back">
    <a href="/designs/lab-notebook">← Back to the notebook</a>
    <span class="lab-label">CTF / Field notes</span>
  </div>
  <header class="article-header">
    <p class="lab-label">
      <time datetime={post.data.pubDatetime.toISOString()}>{date}</time> ·
      Łukasz Budziak
    </p>
    <h1>
      Cyber Apocalypse 2024:
      <br />
      <em>Hacker Royale</em>
    </h1>
    <p class="dek">{post.data.description}</p>
    <div class="article-tags">
      {post.data.tags.map(tag => (
        <a class="lab-tag" href={tagUrl(tag)}>
          {tag}
        </a>
      ))}
    </div>
  </header>
  <div class="article-grid">
    <aside class="article-margin">
      <nav aria-label="Article sections">
        <p class="lab-label">In this entry</p>
        {sections.map(section => (
          <a href={`#${section.slug}`}>{section.text}</a>
        ))}
      </nav>
      <div class="margin-note">
        <svg class="margin-arrow" viewBox="0 0 48 48" aria-hidden="true">
          <path
            d="M7 5v20q0 12 12 12h20m-9-9 9 9-9 9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
        <p class="lab-note">
          Read the clues.
          <br />
          Then write the code.
        </p>
        <p class="margin-caption">
          Web, pwn, crypto,
          <br />
          reversing & automation.
        </p>
      </div>
    </aside>
    <article class="article-body">
      <Content />
      <div class="article-end">
        <p class="lab-note">That's a page worth keeping.</p>
        <a class="lab-arrow" href="/designs/lab-notebook">
          Back to the notebook <span aria-hidden="true">↗</span>
        </a>
        <a class="original" href={`/blog/${post.id}/`}>
          Read in the original blog layout ↗
        </a>
      </div>
    </article>
  </div>
</LabNotebookLayout>
<style>
  .article-back {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 30px 0 0;
    font-size: 14px;
    color: var(--annotation);
  }
  .article-header {
    padding: 44px 0 45px;
    margin-left: 250px;
    border-bottom: 1px solid var(--rule);
  }
  .article-header .lab-label {
    margin: 0 0 24px;
  }
  h1 {
    font:
      58px/1.08 "Lab Lora",
      serif;
    letter-spacing: -2px;
    margin: 0;
  }
  h1 em {
    font-weight: 400;
  }
  .dek {
    font-size: 21px;
    line-height: 1.55;
    max-width: 760px;
    margin: 24px 0;
  }
  .article-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .article-grid {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 60px;
    padding-top: 44px;
  }
  .article-margin {
    align-self: start;
    position: sticky;
    top: 30px;
  }
  .article-margin nav {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .article-margin nav .lab-label {
    margin: 0 0 10px;
    color: var(--annotation);
  }
  .article-margin nav a {
    font-size: 16px;
  }
  .margin-note {
    margin-top: 50px;
    border-top: 1px solid var(--rule);
    padding-top: 25px;
  }
  .margin-arrow {
    display: block;
    width: 38px;
    height: 38px;
    font:
      38px "Lab Lora",
      serif;
    color: var(--annotation);
  }
  .margin-note .lab-note {
    font-size: 21px;
    line-height: 1.4;
    transform: rotate(-4deg);
    margin: 5px 0 23px;
  }
  .margin-caption {
    font:
      10px/1.8 "Fira Code Variable",
      monospace;
    color: var(--annotation);
  }
  .article-body {
    min-width: 0;
    max-width: 830px;
    font-size: 19px;
    line-height: 1.8;
  }
  .article-body :global(h2) {
    font:
      36px/1.2 "Lab Lora",
      serif;
    letter-spacing: -0.6px;
    margin: 55px 0 24px;
    padding-top: 10px;
    scroll-margin-top: 25px;
  }
  .article-body :global(h2:first-child) {
    margin-top: 0;
  }
  .article-body :global(h3) {
    font:
      28px/1.3 "Lab Lora",
      serif;
    margin: 38px 0 20px;
    scroll-margin-top: 25px;
  }
  .article-body :global(h4) {
    font-size: 19px;
    margin: 26px 0 14px;
  }
  .article-body :global(p) {
    margin: 0 0 24px;
  }
  .article-body :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--rule);
    border-radius: 4px;
    margin: 30px 0;
  }
  .article-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--annotation);
  }
  .article-body :global(code:not(pre code)) {
    font:
      14px "Fira Code Variable",
      monospace;
    background: var(--highlight);
    padding: 2px 5px;
    border-radius: 3px;
    overflow-wrap: anywhere;
  }
  .article-body :global(pre) {
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
  }
  .article-body :global(.expressive-code) {
    margin: 24px 0 30px;
    max-width: 100%;
  }
  .article-body :global(blockquote) {
    margin: 24px 0;
    padding: 16px 24px;
    border-left: 3px solid var(--annotation);
    background: var(--chalk);
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 25px;
  }
  .article-end {
    border-top: 1px solid var(--rule);
    margin-top: 55px;
    padding-top: 30px;
  }
  .article-end .lab-note {
    font-size: 30px;
  }
  .article-end .lab-arrow {
    color: var(--ink);
    text-decoration: none;
  }
  .original {
    display: block;
    font-size: 13px;
    margin-top: 24px;
  }
  @media (max-width: 1100px) {
    .article-header {
      margin-left: 210px;
    }
    h1 {
      font-size: 48px;
    }
    .article-grid {
      grid-template-columns: 170px minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 750px) {
    .article-back .lab-label {
      display: none;
    }
    .article-header {
      margin-left: 0;
      padding: 32px 0;
    }
    h1 {
      font-size: 44px;
      letter-spacing: -1.5px;
    }
    .dek {
      font-size: 18px;
    }
    .article-grid {
      display: block;
      padding-top: 24px;
    }
    .article-margin {
      position: static;
      margin-bottom: 35px;
    }
    .article-margin nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 18px;
      padding-bottom: 22px;
      border-bottom: 1px solid var(--rule);
    }
    .article-margin nav .lab-label {
      width: 100%;
      margin: 0 0 7px;
    }
    .article-margin nav a {
      font-size: 14px;
    }
    .margin-note {
      display: none;
    }
    .article-body {
      font-size: 17px;
      line-height: 1.75;
    }
    .article-body :global(h2) {
      font-size: 31px;
    }
    .article-body :global(h3) {
      font-size: 25px;
    }
    .article-body :global(code:not(pre code)) {
      font-size: 12px;
    }
    .article-header .lab-label {
      font-size: 10px;
    }
  }
  @media (max-width: 440px) {
    h1 {
      font-size: 38px;
    }
    .article-header .lab-label {
      line-height: 1.8;
    }
    .article-body :global(pre) {
      font-size: 12px;
    }
  }
</style>
