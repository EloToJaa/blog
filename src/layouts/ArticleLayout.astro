---
import Datetime from "@components/datetime/Datetime.svelte";
import TableOfContents from "@components/posts/TableOfContents/TableOfContents.astro";
import Tags from "@components/posts/Tags.svelte";
import "@styles/asides.css";
import "@styles/props.css";
import { slugify } from "@utils/slugify";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import MainLayout from "./MainLayout.astro";
export type Props = {
  headings: MarkdownHeading[];
  post: CollectionEntry<"blog">;
};
const { post, headings } = Astro.props;
---

<MainLayout title={post.data.title} description={post.data.description} article>
  <article class="article-shell">
    <header class="article-header">
      <a href="/posts" class="text-link text-sm">
        ← All posts
      </a>
      <h1 id={slugify(post.data.title)}>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="post-meta mb-4">
        <Datetime
          datetime={post.data.pubDatetime.toISOString()}
          showTime={false}
        />
      </div>
      <Tags tags={post.data.tags} />
    </header>
    <TableOfContents
      headings={headings}
      minHeadingLevel={2}
      maxHeadingLevel={4}
    />
    <div class="prose">
      <slot />
    </div>
    <div class="mt-12 border-t border-border pt-6">
      <a href="/posts" class="text-link">
        ← Back to all posts
      </a>
    </div>
  </article>
</MainLayout>
