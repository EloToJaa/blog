---
import Footer from "@components/footer/Footer.astro";
import Header from "@components/header/Header.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import MainHead from "./MainHead.astro";

export type Props = {
  title: string;
};

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <MainHead title={title} />
  </head>
  <body>
    <SpeedInsights />
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-content focus:rounded-lg"
    >
      Skip to main content
    </a>
    <div class="grid grid-cols-1 content-between min-h-screen">
      <div>
        <Header />
        <div class="container mx-auto font-main">
          <main id="main-content" class="mt-3 mx-3 text-justify" tabindex="-1">
            <slot />
          </main>
        </div>
      </div>
      <Footer />
    </div>
  </body>
</html>
