---
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/fira-code";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Software engineering and cybersecurity notes by Łukasz Budziak.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · EloToJa</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
      title="EloToJa's Blog"
    />
    <meta name="theme-color" content="#F1ECFA" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="notebook-shell">
      <header class="notebook-header">
        <a class="identity" href="/designs/lab-notebook">
          <span class="identity-mark" aria-hidden="true">
            e.
          </span>
          <span>
            EloToJa<span class="identity-sub">A personal notebook</span>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/designs/lab-notebook#entries">Entries</a>
          <a href="/about">About</a>
          <a href="https://github.com/elotojaa">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="notebook-footer">
        <span>Written by Łukasz Budziak</span>
        <span>Keep exploring. Keep notes.</span>
        <a href="/rss.xml">Follow via RSS ↗</a>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  @font-face {
    font-family: "Lab Lora";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/lab-notebook/lora-latin-400-normal.woff2") format("woff2");
  }
  @font-face {
    font-family: "Lab Lora";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/lab-notebook/lora-latin-400-italic.woff2") format("woff2");
  }
  @font-face {
    font-family: "Lab Lora";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/fonts/lab-notebook/lora-latin-600-normal.woff2") format("woff2");
  }
  @font-face {
    font-family: "Lab Lora";
    font-style: italic;
    font-weight: 600;
    font-display: swap;
    src: url("/fonts/lab-notebook/lora-latin-600-italic.woff2") format("woff2");
  }
  :root {
    --paper: #f1ecfa;
    --ink: #352343;
    --annotation: #69429b;
    --rule: #d9cbe8;
    --highlight: #dcc6f4;
    --chalk: #fcfaff;
    color-scheme: light;
    font-family: "Source Sans 3 Variable", sans-serif;
    color: var(--ink);
    background: var(--paper);
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--annotation);
    outline-offset: 5px;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .skip {
    position: absolute;
    top: -80px;
    left: 20px;
    padding: 12px;
    background: var(--chalk);
    z-index: 5;
  }
  .skip:focus {
    top: 10px;
  }
  .notebook-shell {
    max-width: 1440px;
    margin: auto;
    padding: 0 70px;
  }
  .notebook-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 23px;
    font-weight: 650;
    line-height: 1.1;
  }
  .identity-mark {
    font:
      italic 42px "Lab Lora",
      serif;
    letter-spacing: -6px;
    width: 44px;
    height: 48px;
    border: 1px solid var(--annotation);
    border-radius: 50%;
    padding: 0 7px;
  }
  .identity-sub {
    display: block;
    font-size: 12px;
    letter-spacing: 0.03em;
    font-weight: 400;
    margin-top: 7px;
    color: var(--annotation);
  }
  .notebook-header nav {
    display: flex;
    gap: 32px;
    font-size: 16px;
  }
  .notebook-footer {
    margin-top: 64px;
    border-top: 1px solid var(--rule);
    padding: 28px 0 35px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 14px;
    color: var(--annotation);
  }
  .lab-label {
    font:
      11px "Fira Code Variable",
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .lab-tag {
    display: inline-block;
    font:
      11px "Fira Code Variable",
      monospace;
    border: 1px solid var(--rule);
    border-radius: 30px;
    padding: 6px 10px;
  }
  .lab-arrow {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    font-size: 16px;
    font-weight: 600;
  }
  .lab-arrow span {
    font-size: 25px;
    font-weight: 400;
  }
  .lab-note {
    font:
      italic 24px "Lab Lora",
      serif;
    color: var(--annotation);
  }
  @media (max-width: 800px) {
    .notebook-shell {
      padding: 0 28px;
    }
    .notebook-header {
      padding: 24px 0;
    }
    .notebook-header nav {
      gap: 20px;
    }
    .notebook-footer {
      flex-wrap: wrap;
      margin-top: 40px;
    }
    .notebook-footer span:nth-child(2) {
      display: none;
    }
  }
  @media (max-width: 440px) {
    .notebook-shell {
      padding: 0 20px;
    }
    .identity {
      gap: 10px;
      font-size: 20px;
    }
    .identity-mark {
      font-size: 34px;
      width: 36px;
      height: 39px;
      padding-left: 5px;
    }
    .identity-sub {
      font-size: 10px;
    }
    .notebook-header nav {
      gap: 14px;
      font-size: 14px;
    }
    .notebook-header nav a:last-child {
      display: none;
    }
    .notebook-footer {
      font-size: 12px;
    }
  }
</style>
