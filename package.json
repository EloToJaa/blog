{
  "name": "blog",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vp exec astro dev",
    "start": "vp exec astro dev",
    "build": "vp exec astro build",
    "preview": "vp exec astro preview",
    "format": "vp fmt --config .oxfmtrc.json . && prettier --write \"src/**/*.{astro,svelte}\"",
    "format:check": "vp fmt --config .oxfmtrc.json . --check && prettier --check \"src/**/*.{astro,svelte}\"",
    "lint": "vp lint --config .oxlintrc.json && eslint .",
    "sync": "astro sync",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@lucide/svelte": "^1.51.0",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.3.5",
    "astro-expressive-code": "^0.44.2",
    "clsx": "^2.1.1",
    "effect": "^4.0.0",
    "fuse.js": "^7.5.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.538",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/bun": "1.4.2",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-to-hast": "^13.2.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
